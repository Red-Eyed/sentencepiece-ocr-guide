{
  "paths": ["corpus/"],
  "model_prefix": "ocr_tokenizer",
  "lines": 20000000,
  "alpha": 0.3,
  "seed": 13,
  "vocab_size": 40000,
  "character_coverage": 0.9998,
  "max_sentence_length": 16384,
  "max_sentencepiece_length": 8,
  "shuffle_buffer_lines": 100000,
  "memory_budget_gb": 32,
  "training_temp_dir": "scratch/",
  "keep_training_file": true,
  "balance_math": false,
  "math_max_share": 0.1,
  "spm_threads": 16,
  "trainer_backend": "uv-python",
  "spm_train": "spm_train",
  "decide": [],
  "drop_invalid": false,
  "drop_long_lines": false,
  "user_defined_symbols": [],
  "user_defined_symbols_file": null
}
