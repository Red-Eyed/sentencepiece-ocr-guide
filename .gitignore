# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Tool caches
.ruff_cache/
.pytest_cache/
.coverage

# Tokenizer artifacts and corpora — never commit these
*.model
*.vocab
corpora/
/target

# ...except the test fixtures. Training them needs a SentencePiece trainer, which this project
# deliberately does not depend on, so they are checked in rather than regenerated.
!tests/fixtures/*.model
